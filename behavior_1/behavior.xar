from naoqi import ALProxy
import time

class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        self.memory = ALProxy("ALMemory")
        self.tablet = ALProxy("ALTabletService")
        self.tts=ALProxy("ALTextToSpeech")
        self.dialog = ALProxy("ALDialog")

        self.memory.subscribeToEvent(
            "introductions",
            self.getName(),
            "onVoiceEvent"
        )
        self.memory.subscribeToEvent(
            "buttonback",
            self.getName(),
            "onTabletEvent"
        )

        self.memory.subscribeToEvent(
            "weatherData",
            self.getName(),
            "onWeatherEvent"
        )

    def onUnload(self):
        self.memory.unsubscribeToEvent(
            "introductions",
            self.getName()
        )

        self.memory.unsubscribeToEvent(
            "buttonback",
            self.getName()
        )

        self.memory.unsubscribeToEvent(
            "weatherData",
            self.getName()
        )

    def onVoiceEvent(self, key, value, message):
        print "Event:", key
        print "Value:", value

        if value == "welcome":
            self.showPage("welcome.html")

        #Voice interaction roomlist
        elif value == "roomlists":
            self.showPage("roomlists.html")

        elif value == "room1":
            self.showPage("room.html?title=Director%20Office&img=images/director-office.jpg")

        elif value == "room2":
            self.showPage("room.html?title=IT%20Room&img=images/it-room.jpg")


        elif value == "programs":
            self.showPage("programs.html")
        elif value =="program1":
            self.showPage("program1.html")
        elif value == "program2":
            self.showPage("program2.html")
        elif value == "program3":
            self.showPage("program3.html")
        elif value == "program4":
            self.showPage("program4.html")
        elif value == "program5":
            self.showPage("program5.html")
        elif value == "program6":
            self.showPage("program6.html")

        elif value == "reset":
            self.showPage("welcome.html")
        elif value == "history":
            self.showPage("history.html")
        elif value == "contact":
            self.showPage("contact.html")

        elif value=="weather":
            self.showPage("weather.html")

    def onTabletEvent(self, key, value, message):
        print "Back Event:", key
        print "Back to tag:", value

        tag_name = str(value)

        #programs information

        if tag_name == "informationMenu":
            self.tts.say("back to the main menu")
            time.sleep(2)
            self.showPage("welcome.html")

            self.dialog.gotoTag(
                "informationMenu",
                "greetingtopic"
            )

        elif tag_name == "programList":
            self.showPage("programs.html")

            self.dialog.gotoTag(
                "programMenu",
                "greetingtopic"
            )

        elif tag_name =="program1":

            self.showPage("program1.html")

            self.dialog.gotoTag(
                "program1",
                "greetingtopic"
            )

        elif tag_name =="program2":

            self.showPage("program2.html")

            self.dialog.gotoTag(
                "program2",
                "greetingtopic"
            )

        elif tag_name =="program3":

            self.showPage("program3.html")

            self.dialog.gotoTag(
                "program3",
                "greetingtopic"
            )

        elif tag_name =="program4":

            self.showPage("program4.html")

            self.dialog.gotoTag(
                "program4",
                "greetingtopic"
            )

        #roomList for direction

        elif tag_name == "roomlist":
            self.showPage("roomlists.html")

            self.dialog.gotoTag(
                "roomList",
                "greetingtopic"
            )


        elif tag_name == "room1":


            self.dialog.gotoTag(
                "room1",
                "greetingtopic"
            )

        elif tag_name == "room2":


            self.dialog.gotoTag(
                "room2",
                "greetingtopic"
            )

        elif tag_name == "room3":


            self.dialog.gotoTag(
                "room3",
                "greetingtopic"
            )

        #History information
        elif tag_name == "historyMenu":
            self.showPage("history.html")

            self.dialog.gotoTag(
                "historyMenu",
                "greetingtopic"
            )

        else:
            print "Unknown tag:", tag_name

    def onWeatherEvent(self, key, value, message):

        self.logger.info(
            "========== WEATHER EVENT START =========="
        )

        # STEP 1
        self.logger.info(
            "STEP 1: onWeatherEvent triggered"
        )

        self.logger.info(
            "Event key: " + str(key)
        )

        self.logger.info(
            "Received value: " + str(value)
        )


        try:

            # STEP 2
            self.logger.info(
                "STEP 2: Converting value to string"
            )

            weatherData = str(value)

            self.logger.info(
                "weatherData = " + weatherData
            )


            # STEP 3
            self.logger.info(
                "STEP 3: Splitting weather data"
            )

            parts = weatherData.split("|")

            self.logger.info(
                "Number of parts = " + str(len(parts))
            )


            # Check data
            if len(parts) < 2:

                self.logger.error(
                    "ERROR: Invalid weather data"
                )

                self.logger.error(
                    "Expected format: Weather|Temperature"
                )

                return


            # STEP 4
            self.logger.info(
                "STEP 4: Reading weather value"
            )

            weather = parts[0]

            self.logger.info(
                "Weather = " + weather
            )


            # STEP 5
            self.logger.info(
                "STEP 5: Reading temperature value"
            )

            temperature = parts[1]

            self.logger.info(
                "Temperature = " + temperature
            )


            # STEP 6
            self.logger.info(
                "STEP 6: Creating TTS text"
            )

            text = (
                "Today's weather is "
                + weather
                + ". The temperature is "
                + temperature
                + " degrees Celsius."

            )

            self.logger.info(
                "TTS text = " + text
            )


            # STEP 7
            self.logger.info(
                "STEP 7: Calling ALTextToSpeech.say()"
            )

            self.tts.say(text)


            # STEP 8
            self.logger.info(
                "STEP 8: TTS completed successfully"
            )

            self.memory.raiseEvent(
                "weatherFinished",
                True
            )


        except Exception as error:

            self.logger.error(
                "WEATHER EVENT ERROR: "
                + str(error)
            )


        self.logger.info(
            "========== WEATHER EVENT END =========="
        )


    def showPage(self, page):
        try:
            if page.startswith("http://") or page.startswith("https://"):
                url = page
            else:
                url = (
                    "http://198.18.0.1/apps/"
                    ".lastUploadedChoregrapheBehavior/"
                    + page
                    + "?v="
                    + str(int(time.time()))
                )

            print "Loading page:", url

            load_result = self.tablet.loadUrl(url)
            print "loadUrl result:", load_result

            show_result = self.tablet.showWebview()
            print "showWebview result:", show_result

        except Exception as error:
            print "showPage error:", error]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /></Box><Box name="Show Web View (2)" id="20" localization="8" tooltip="Shows the webview (html content) on the tablet.&#x0A;&#x0A;V1.0.0&#x0A;" x="149" y="210"><bitmap>media/images/box/internet/internet.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def _getTabletService(self):
        tabletService = None
        try:
            tabletService = self.session().service("ALTabletService")
        except Exception as e:
            self.logger.error(e)
        return tabletService

    def onInput_onStart(self):
        tabletService = self._getTabletService()

        if tabletService:
            tabletService.loadUrl("http://141.132.126.174:8000/index.html")
            tabletService.showWebview()
        else:
            self.logger.warning("ALTabletService not found.")

        self.onStopped()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="3" /></Box><Box name="sds" id="21" localization="8" tooltip="" x="202" y="336"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        #put initialization code here
        pass

    def onUnload(self):
        #put clean-up code here
        pass

    def onInput_onStart(self):
        #self.onStopped() #activate the output of the box
        pass

    def onInput_onStop(self):
        self.onUnload() #it is recommended to reuse the clean-up as the box is stopped
        self.onStopped() #activate the output of the box]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /></Box><Link inputowner="8" indexofinput="2" outputowner="5" indexofoutput="4" /><Link inputowner="8" indexofinput="2" outputowner="6" indexofoutput="4" /><Link inputowner="7" indexofinput="2" outputowner="8" indexofoutput="4" /><Link inputowner="9" indexofinput="2" outputowner="7" indexofoutput="5" /><Link inputowner="9" indexofinput="3" outputowner="7" indexofoutput="6" /><Link inputowner="7" indexofinput="2" outputowner="9" indexofoutput="8" /><Link inputowner="11" indexofinput="2" outputowner="9" indexofoutput="5" /><Link inputowner="12" indexofinput="2" outputowner="9" indexofoutput="6" /><Link inputowner="10" indexofinput="2" outputowner="9" indexofoutput="7" /><Link inputowner="0" indexofinput="4" outputowner="17" indexofoutput="4" /><Link inputowner="14" indexofinput="2" outputowner="1" indexofoutput="4" /><Link inputowner="17" indexofinput="2" outputowner="0" indexofoutput="2" /><Link inputowner="16" indexofinput="2" outputowner="14" indexofoutput="3" /><Link inputowner="1" indexofinput="2" outputowner="0" indexofoutput="2" /><Link inputowner="0" indexofinput="4" outputowner="16" indexofoutput="4" /></Diagram></BehaviorKeyframe></BehaviorLayer></Timeline></Box></ChoregrapheProject>