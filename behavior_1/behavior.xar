bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[# -*- coding: utf-8 -*-

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

        self.asr = None
        self.memory = None
        self.subscriber = None
        self.signal_id = None

        self.module_name = "SimpleSpeechRecoBox"
        self.vocabulary = ["one", "two", "three"]
        self.confidence_threshold = 0.40

        self.is_listening = False
        self.has_finished = False

    def onLoad(self):
        self.logger.info("SimpleSpeechRecoBox loaded")
        self._init_services()

    def onUnload(self):
        self._stop_listening()

    def onInput_onStart(self):
        try:
            self.has_finished = False
            self.logger.info("Start listening...")
            self._init_services()

            #clearing vacabulary list at first
            self._set_vocabulary_safely(self.vocabulary)

            #then start lis
            self._start_listening()

        except Exception as e:
            self.logger.error("Failed to start ASR: %s" % str(e))
            self._finish_default()

    def onInput_onStop(self):
        self.logger.info("SpeechReco stopped by user")
        self._finish_default()

    def _init_services(self):
        if self.asr is None:
            self.asr = self.session().service("ALSpeechRecognition")
        if self.memory is None:
            self.memory = self.session().service("ALMemory")

    def change_vocabulary(self, new_words):
        self._set_vocabulary_safely(new_words)

    def _set_vocabulary_safely(self, new_words):
        self.logger.info("Setting vocabulary safely: %s" % str(new_words))

        self._stop_listening()

        try:
            self.asr.pause(True)
        except Exception:
            pass

        self.vocabulary = new_words
        self.asr.setLanguage("English")
        self.asr.setVocabulary(self.vocabulary, False)

        try:
            self.asr.pause(False)
        except Exception:
            pass

    def _start_listening(self):
        self._stop_listening()

        self.subscriber = self.memory.subscriber("WordRecognized")
        self.signal_id = self.subscriber.signal.connect(self.on_word_recognized)

        self.asr.subscribe(self.module_name)
        self.is_listening = True

        self.logger.info("ASR subscribed")

    def _stop_listening(self):
        try:
            if self.subscriber is not None and self.signal_id is not None:
                self.subscriber.signal.disconnect(self.signal_id)
        except Exception:
            pass

        self.signal_id = None
        self.subscriber = None

        try:
            if self.asr is not None:
                self.asr.unsubscribe(self.module_name)
        except Exception:
            pass

        self.is_listening = False

    def on_word_recognized(self, value):
        try:
            if not self.is_listening or self.has_finished:
                return

            if value is None or len(value) < 2:
                return

            heard_word = str(value[0]).strip().lower()
            confidence = float(value[1])

            self.logger.info("WordRecognized raw: %s" % str(value))

            if heard_word == "":
                return

            if confidence < self.confidence_threshold:
                self.logger.info("Confidence too low: %s" % str(confidence))
                return

            self.has_finished = True
            self._stop_listening()

            self.word(heard_word)
            self.recognized()
            self.onStopped()

        except Exception as e:
            self.logger.error("Recognition callback error: %s" % str(e))
            self._finish_default()

    def _finish_default(self):
        if self.has_finished:
            return

        self.has_finished = True
        self._stop_listening()

        try:
            self.onDefault()
        except Exception:
            pass

        self.onStopped()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /><Output name="recognized" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" /><Output name="word" type="3" type_size="1" nature="2" inner="0" tooltip="" id="6" /><Output name="onDefault" type="1" type_size="1" nature="2" inner="0" tooltip="" id="7" /></Box><Box name="Say (4)" id="8" localization="8" tooltip="Say some text. The text can be localized." x="723" y="592"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)
        self.tts = ALProxy('ALTextToSpeech')
        self.ttsStop = ALProxy('ALTextToSpeech', True) #Create another proxy as wait is blocking if audioout is remote

    def onLoad(self):
        self.bIsRunning = False
        self.ids = []

    def onUnload(self):
        for id in self.ids:
            try:
                self.ttsStop.stop(id)
            except:
                pass

        self.bIsRunning = False

    def onInput_onStart(self):
        self.bIsRunning = True
        try:
            sentence = "\RSPD="+ str( self.getParameter("Speed (%)") ) + "\ "
            sentence += "\VCT="+ str( self.getParameter("Voice shaping (%)") ) + "\ "
            sentence += self.getParameter("Text")
            sentence +=  "\RST\ "
            id = self.tts.post.say(str(sentence))
            self.ids.append(id)
            self.tts.wait(id, 0)
        finally:
            try:
                self.ids.remove(id)
            except:
                pass
            if( self.ids == [] ):
                self.onStopped() # activate output of the box
                self.bIsRunning = False

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when Diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this Input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this Input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when Box behavior is finished." id="4" /><Parameter name="Voice shaping (%)" inherits_from_parent="1" content_type="1" value="103" default_value="100" min="50" max="150" tooltip='Used to modify at runtime the voice feature (tone, speed). In a slighty&#x0A;different way than pitch and speed, it gives a kind of &quot;gender or age&#x0A;modification&quot; effect.&#x0A;&#x0A;For instance, a quite good male derivation of female voice can be&#x0A;obtained setting this parameter to 78%.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the&#x0A;speed parameter. For example, if you want to decrease by 20% the voice&#x0A;shaping, you will have to increase by 20% the speed to keep a constant&#x0A;average speed.' id="5" /><Parameter name="Speed (%)" inherits_from_parent="1" content_type="1" value="100" default_value="100" min="50" max="200" tooltip="Changes the speed of the voice.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the voice&#x0A;shaping parameter. For example, if you want to increase by 20% the speed, you&#x0A;will have to decrease by 20% the voice shaping to keep a constant average&#x0A;speed." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="5" value="Which one do you want to know" default_value="" tooltip="The text you want to say. Don&apos;t forget to translate it!" id="7" /></Box><Box name="new switch box (1)" id="9" localization="8" tooltip="" x="1036" y="332"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[# -*- coding: utf-8 -*-

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)
        self.last_word = None

    def onInput_word(self, value):
        # 保存输入的字符串
        try:
            self.last_word = str(value).strip().lower()
            self.logger.info("Received word: %s" % self.last_word)
        except:
            self.last_word = None

    def onInput_onStart(self):
        # 每次触发时根据 last_word 做判断
        if not self.last_word:
            self.logger.info("No word received")
            self.onDefault()
            return

        word = self.last_word

        if word == "one":
            self.logger.info("Matched TEA")
            self.onOne()

        elif word == "two":
            self.logger.info("Matched COFFEE")
            self.onTwo()

        elif word == "three":
            self.logger.info("Matched HELLO")
            self.onThree()

        else:
            self.logger.info("Default branch")
            self.onDefault()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="word" type="3" type_size="1" nature="1" inner="0" tooltip="" id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /><Output name="onOne" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" /><Output name="onTwo" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" /><Output name="onThree" type="1" type_size="1" nature="2" inner="0" tooltip="" id="7" /><Output name="onDefault" type="1" type_size="1" nature="2" inner="0" tooltip="" id="8" /><Parameter name="Parameter" inherits_from_parent="0" content_type="3" value="one" default_value="two" custom_choice="1" tooltip="" id="9"><Choice value="one" /><Choice value="two" /></Parameter></Box><Box name="Say (5)" id="10" localization="8" tooltip="Say some text. The text can be localized." x="1183" y="870"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)
        self.tts = ALProxy('ALTextToSpeech')
        self.ttsStop = ALProxy('ALTextToSpeech', True) #Create another proxy as wait is blocking if audioout is remote

    def onLoad(self):
        self.bIsRunning = False
        self.ids = []

    def onUnload(self):
        for id in self.ids:
            try:
                self.ttsStop.stop(id)
            except:
                pass

        self.bIsRunning = False

    def onInput_onStart(self):
        self.bIsRunning = True
        try:
            sentence = "\RSPD="+ str( self.getParameter("Speed (%)") ) + "\ "
            sentence += "\VCT="+ str( self.getParameter("Voice shaping (%)") ) + "\ "
            sentence += self.getParameter("Text")
            sentence +=  "\RST\ "
            id = self.tts.post.say(str(sentence))
            self.ids.append(id)
            self.tts.wait(id, 0)
        finally:
            try:
                self.ids.remove(id)
            except:
                pass
            if( self.ids == [] ):
                self.onStopped() # activate output of the box
                self.bIsRunning = False

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when Diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this Input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this Input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when Box behavior is finished." id="4" /><Parameter name="Voice shaping (%)" inherits_from_parent="1" content_type="1" value="97" default_value="100" min="50" max="150" tooltip='Used to modify at runtime the voice feature (tone, speed). In a slighty&#x0A;different way than pitch and speed, it gives a kind of &quot;gender or age&#x0A;modification&quot; effect.&#x0A;&#x0A;For instance, a quite good male derivation of female voice can be&#x0A;obtained setting this parameter to 78%.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the&#x0A;speed parameter. For example, if you want to decrease by 20% the voice&#x0A;shaping, you will have to increase by 20% the speed to keep a constant&#x0A;average speed.' id="5" /><Parameter name="Speed (%)" inherits_from_parent="1" content_type="1" value="97" default_value="100" min="50" max="200" tooltip="Changes the speed of the voice.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the voice&#x0A;shaping parameter. For example, if you want to increase by 20% the speed, you&#x0A;will have to decrease by 20% the voice shaping to keep a constant average&#x0A;speed." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="5" value="This is project 2" default_value="" tooltip="The text you want to say. Don&apos;t forget to translate it!" id="7" /></Box><Box name="Say (6)" id="11" localization="8" tooltip="Say some text. The text can 