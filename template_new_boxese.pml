<?xml version="1.0" encoding="UTF-8" ?>
<Package name="template_new_boxese" format_version="4">
    <Manifest src="manifest.xml" />
    <BehaviorDescriptions>
        <BehaviorDescription name="behavior" src="behavior_1" xar="behavior.xar" />
    </BehaviorDescriptions>
    <Dialogs>
        <Dialog name="greetingtopic" src="greetingtopic/greetingtopic.dlg" />
        <Dialog name="directions" src="directions/directions.dlg" />
    </Dialogs>
    <Resources>
        <File name="Here-are-directions-to-the-level-1-toilets" src="html/images/Here-are-directions-to-the-level-1-toilets.jpg" />
        <File name="breakout-room" src="html/images/breakout-room.jpg" />
        <File name="director-office" src="html/images/director-office.jpg" />
        <File name="food-room" src="html/images/food-room.jpg" />
        <File name="it-room" src="html/images/it-room.jpg" />
        <File name="meeting-room" src="html/images/meeting-room.jpg" />
        <File name="new-energy-map" src="html/images/new-energy-map.jpg" />
        <File name="presentation-space" src="html/images/presentation-space.jpg" />
        <File name="science-prep-room" src="html/images/science-prep-room.jpg" />
        <File name="science-room" src="html/images/science-room.jpg" />
        <File name="staff-lunch-room" src="html/images/staff-lunch-room.jpg" />
        <File name="staff-room" src="html/images/staff-room.jpg" />
        <File name="studio-room" src="html/images/studio-room.jpg" />
        <File name="toilet2" src="html/images/toilet2.jpg" />
        <File name="qimessaging" src="html/libs/qimessaging/2/qimessaging.js" />
        <File name="contact" src="html/contact.html" />
        <File name="history" src="html/history.html" />
        <File name="program1" src="html/program1.html" />
        <File name="programs" src="html/programs.html" />
        <File name="room" src="html/room.html" />
        <File name="roomlists" src="html/roomlists.html" />
        <File name="style" src="html/style.css" />
        <File name="tag" src="html/tag.js" />
        <File name="weather" src="html/weather.html" />
        <File name="welcome" src="html/welcome.html" />
        <File name="html" src="html.zip" />
    </Resources>
    <Topics>
        <Topic name="greetingtopic_enu" src="greetingtopic/greetingtopic_enu.top" topicName="greetingtopic" language="en_US" />
        <Topic name="directions_enu" src="directions/directions_enu.top" topicName="directions" language="en_US" />
    </Topics>
    <IgnoredPaths>
        <Path src="behavior_1/new speech reco box.py" />
    </IgnoredPaths>
    <Translations auto-fill="en_US">
        <Translation name="translation_en_US" src="translations/translation_en_US.ts" language="en_US" />
    </Translations>
</Package>
