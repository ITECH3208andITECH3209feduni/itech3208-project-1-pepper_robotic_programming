<?xml version="1.0" encoding="UTF-8" ?><ChoregrapheProject xmlns="http://www.aldebaran-robotics.com/schema/choregraphe/project.xsd" xar_version="3"><Box name="root" id="-1" localization="8" tooltip="Root box of Choregraphe&apos;s behavior. Highest level possible." x="0" y="0"><bitmap>media/images/box/root.png</bitmap><script language="4"><content><![CDATA[]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /><Timeline enable="0"><BehaviorLayer name="behavior_layer1"><BehaviorKeyframe name="keyframe1" index="1"><Diagram scale="84.0896"><Box name="Say" id="1" localization="8" tooltip="Say some text. The text can be localized." x="407" y="42"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)
        self.tts = ALProxy('ALTextToSpeech')
        self.ttsStop = ALProxy('ALTextToSpeech', True) #Create another proxy as wait is blocking if audioout is remote

    def onLoad(self):
        self.bIsRunning = False
        self.ids = []

    def onUnload(self):
        for id in self.ids:
            try:
                self.ttsStop.stop(id)
            except:
                pass

        self.bIsRunning = False

    def onInput_onStart(self):
        self.bIsRunning = True
        try:
            sentence = "\RSPD="+ str( self.getParameter("Speed (%)") ) + "\ "
            sentence += "\VCT="+ str( self.getParameter("Voice shaping (%)") ) + "\ "
            sentence += self.getParameter("Text")
            sentence +=  "\RST\ "
            id = self.tts.post.say(str(sentence))
            self.ids.append(id)
            self.tts.wait(id, 0)
        finally:
            try:
                self.ids.remove(id)
            except:
                pass
            if( self.ids == [] ):
                self.onStopped() # activate output of the box
                self.bIsRunning = False

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when Diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this Input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this Input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when Box behavior is finished." id="4" /><Parameter name="Voice shaping (%)" inherits_from_parent="1" content_type="1" value="100" default_value="100" min="50" max="150" tooltip='Used to modify at runtime the voice feature (tone, speed). In a slighty&#x0A;different way than pitch and speed, it gives a kind of &quot;gender or age&#x0A;modification&quot; effect.&#x0A;&#x0A;For instance, a quite good male derivation of female voice can be&#x0A;obtained setting this parameter to 78%.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the&#x0A;speed parameter. For example, if you want to decrease by 20% the voice&#x0A;shaping, you will have to increase by 20% the speed to keep a constant&#x0A;average speed.' id="5" /><Parameter name="Speed (%)" inherits_from_parent="1" content_type="1" value="97" default_value="100" min="50" max="200" tooltip="Changes the speed of the voice.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the voice&#x0A;shaping parameter. For example, if you want to increase by 20% the speed, you&#x0A;will have to decrease by 20% the voice shaping to keep a constant average&#x0A;speed." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="5" value="Hello, welcome to ballarat tech school." default_value="" tooltip="The text you want to say. Don&apos;t forget to translate it!" id="7" /></Box><Box name="Say (8)" id="4" localization="8" tooltip="Say some text. The text can be localized." x="1549" y="667"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)
        self.tts = ALProxy('ALTextToSpeech')
        self.ttsStop = ALProxy('ALTextToSpeech', True) #Create another proxy as wait is blocking if audioout is remote

    def onLoad(self):
        self.bIsRunning = False
        self.ids = []

    def onUnload(self):
        for id in self.ids:
            try:
                self.ttsStop.stop(id)
            except:
                pass
        while( self.bIsRunning ):
            time.sleep( 0.2 )

    def onInput_onStart(self):
        self.bIsRunning = True
        try:
            sentence = "\RSPD="+ str( self.getParameter("Speed (%)") ) + "\ "
            sentence += "\VCT="+ str( self.getParameter("Voice shaping (%)") ) + "\ "
            sentence += self.getParameter("Text")
            sentence +=  "\RST\ "
            id = self.tts.post.say(str(sentence))
            self.ids.append(id)
            self.tts.wait(id, 0)
        finally:
            try:
                self.ids.remove(id)
            except:
                pass
            if( self.ids == [] ):
                self.onStopped() # activate output of the box
                self.bIsRunning = False

    def onInput_onStop(self):
        self.onUnload()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when Diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this Input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this Input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when Box behavior is finished." id="4" /><Parameter name="Voice shaping (%)" inherits_from_parent="1" content_type="1" value="100" default_value="100" min="50" max="150" tooltip='Used to modify at runtime the voice feature (tone, speed). In a slighty&#x0A;different way than pitch and speed, it gives a kind of &quot;gender or age&#x0A;modification&quot; effect.&#x0A;&#x0A;For instance, a quite good male derivation of female voice can be&#x0A;obtained setting this parameter to 78%.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the&#x0A;speed parameter. For example, if you want to decrease by 20% the voice&#x0A;shaping, you will have to increase by 20% the speed to keep a constant&#x0A;average speed.' id="5" /><Parameter name="Speed (%)" inherits_from_parent="1" content_type="1" value="100" default_value="100" min="50" max="200" tooltip="Changes the speed of the voice.&#x0A;&#x0A;Note: For a better effect, you can compensate this parameter with the voice&#x0A;shaping parameter. For example, if you want to increase by 20% the speed, you&#x0A;will have to decrease by 20% the voice shaping to keep a constant average&#x0A;speed." id="6" /><Parameter name="Text" inherits_from_parent="0" content_type="5" value="Hello" default_value="" tooltip="The text you want to say. Don&apos;t forget to translate it!" id="7" /></Box><Box name="Set Language" id="14" localization="8" tooltip="Set the language of your robot for the current application. Your robot will speak and understand the selected language as long as your application has focus. Any following call to ALSpeechRecognition (Speech Reco. box for instance), ALTextToSpeech (Say box for instance) or ALDialog will use this language.&#x0A;" x="545" y="55"><bitmap>media/images/box/interaction/say.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self, False)

    def onLoad(self):
        try:
            self.tts = ALProxy("ALTextToSpeech")
        except:
            self.logger.warn("ALTextToSpeech is not available, language setting cannot be applied to speech")
            self.tts = None

        try:
            self.asr = ALProxy("ALSpeechRecognition")
        except:
            self.logger.warn("ALSpeechRecognition is not available, language setting cannot be applied to recognition")
            self.asr = None

        try:
            self.dialog = ALProxy("ALDialog")
        except:
            self.logger.warn("ALDialog is not available, language setting cannot be applied to dialog")
            self.dialog = None

    def onInput_onSet(self):
        lang = self.getParameter("Language")
        try:
            if self.asr:
                self.asr.setLanguage( self.getParameter("Language") )
            if self.tts:
                self.tts.setLanguage( self.getParameter("Language") )
            if self.dialog:
                self.dialog.setLanguage( self.getParameter("Language") )
            if self.tts is None and self.asr is None and self.dialog is None:
                raise RuntimeError("Cannot set language: neither ALTextToSpeech nor ALSpeechRecognition nor ALDialog is available.")
            self.onReady()
        except:
            error = "Language " + lang + " cannot be set."
            self.logger.warn(error)
            self.onError(error)]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onSet" type="1" type_size="1" nature="1" inner="0" tooltip="The data is set when a signal is received on this input." id="2" /><Output name="onReady" type="1" type_size="1" nature="2" inner="0" tooltip="Signal sent when the data has been set." id="3" /><Output name="onError" type="3" type_size="1" nature="2" inner="0" tooltip="Error output:&#x0A;- triggered if the language asked cannot be set" id="4" /><Parameter name="Language" inherits_from_parent="0" content_type="3" value="English" default_value="English" custom_choice="1" tooltip="Set the language the robot speaks and understands." id="5"><Choice value="Arabic" /><Choice value="Brazilian" /><Choice value="Chinese" /><Choice value="Czech" /><Choice value="Danish" /><Choice value="Dutch" /><Choice value="English" /><Choice value="Finnish" /><Choice value="French" /><Choice value="German" /><Choice value="Greek" /><Choice value="Italian" /><Choice value="Japanese" /><Choice value="Korean" /><Choice value="MandarinTaiwan" /><Choice value="Norwegian" /><Choice value="Polish" /><Choice value="Portuguese" /><Choice value="Russian" /><Choice value="Spanish" /><Choice value="Swedish" /><Choice value="Turkish" /></Parameter><Resource name="Speech" type="Lock" timeout="0" /></Box><Box name="greetings" id="16" localization="8" tooltip="" x="962" y="41"><dialogFile>../greetingtopic/greetingtopic.dlg</dialogFile><bitmap>media/images/box/box-dialog.png</bitmap><script language="4"><content><![CDATA[]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /></Box><Box name="functions" id="17" localization="8" tooltip="" x="629" y="174"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[
from naoqi import ALProxy
import time

class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)
    # ========================================
    # Face recognition state
    # ========================================

        self.faceMode = None

        self.recognitionRunning = False
        self.registrationRunning = False

        self.registrationName = ""

        self.lastRecognizedName = ""

    def onLoad(self):

        # ========================================
        # NAOqi proxies
        # ========================================

        self.memory = ALProxy("ALMemory")
        self.tablet = ALProxy("ALTabletService")
        self.tts = ALProxy("ALTextToSpeech")
        self.dialog = ALProxy("ALDialog")
        self.faceDetection = ALProxy("ALFaceDetection")


        # ========================================
        # DEBUG DIALOG
        # ========================================

        try:

            topics = self.dialog.getActivatedTopics()

            self.logger.info(
                "Activated topics on load: "
                + str(topics)
            )

        except Exception as error:

            self.logger.error(
                "getActivatedTopics error: "
                + str(error)
            )


        try:

            focus = self.dialog.getFocus()

            self.logger.info(
                "Current dialog focus on load: "
                + str(focus)
            )

        except Exception as error:

            self.logger.error(
                "getFocus error: "
                + str(error)
            )


        # ========================================
        # Start ALFaceDetection
        # ========================================

        try:

            self.faceDetection.subscribe(
                self.getName(),
                500,
                0.0
            )

            self.logger.info(
                "ALFaceDetection subscribed successfully."
            )

        except Exception as error:

            self.logger.error(
                "ALFaceDetection subscribe error: "
                + str(error)
            )


        # ========================================
        # Subscribe to ALMemory events
        # ========================================

        self.memory.subscribeToEvent(
            "introductions",
            self.getName(),
            "onVoiceEvent"
        )

        self.memory.subscribeToEvent(
            "buttonback",
            self.getName(),
            "onTabletEvent"
        )

        self.memory.subscribeToEvent(
            "weatherData",
            self.getName(),
            "onWeatherEvent"
        )

        self.memory.subscribeToEvent(
            "FaceDetected",
            self.getName(),
            "onFaceDetected"
        )
    def onUnload(self):
        self.memory.unsubscribeToEvent(
            "introductions",
            self.getName()
        )

        self.memory.unsubscribeToEvent(
            "buttonback",
            self.getName()
        )

        self.memory.unsubscribeToEvent(
            "weatherData",
            self.getName()
        )

#        self.memory.unsubscribeToEvent(
#            "ReceptionAnswer",
#            self.getName()
#        )

        try:

            self.memory.unsubscribeToEvent(
                "FaceDetected",
                self.getName()
            )

        except Exception as error:

            self.logger.warning(
                "FaceDetected unsubscribe error: "
                + str(error)
            )


        self.recognitionRunning = False
        self.registrationRunning = False
        self.faceMode = None

        try:

            self.faceDetection.unsubscribe(
                self.getName()
            )

            self.logger.info(
                "ALFaceDetection unsubscribed."
            )

        except Exception as error:

            self.logger.warning(
                "ALFaceDetection unsubscribe error: "
                + str(error)
            )


    def onVoiceEvent(self, key, value, message):
        print "Event:", key
        print "Value:", value

        if value == "startPage":
            self.showPage("start.html")

        elif value == "mainMenu":
            self.showPage("mainMenu.html")

        elif value == "roomlists":
            self.showPage("roomlists.html")

        elif value == "programMenu":
            self.showPage("programs/programs.html")

        elif value == "history":
            self.showPage("history.html")

        elif value == "weather":
            self.showPage("weather.html")

        elif value == "contact":
            self.showPage("contact.html")

        elif value == "facialMenu":
            self.showPage("facialMenu.html")





        # ========================================
        # Rooms
        # ========================================


        elif value == "room1":
            self.showPage("room.html?title=Director%20Office&img=images/director-office.jpg")

        elif value == "room2":
            self.showPage("room.html?title=IT%20Room&img=images/it-room.jpg")

        elif value == "room3":
            self.showPage("room.html?title=Meeting%20Room&amp;img=images/meeting-room.jpg")

        elif value == "room4":
            self.showPage("room.html?title=New%20Energy%20Map&amp;img=images/new-energy-map.jpg")

        elif value == "room5":
            self.showPage("room.html?title=Presentation%20Space&amp;img=images/presentation-space.jpg")

        elif value == "room6":
            self.showPage("room.html?title=Staff%20Room&amp;img=images/staff-room.jpg")

        elif value == "room7":
            self.showPage("room.html?title=Level%201%20Toilets&amp;img=images/Here-are-directions-to-the-level-1-toilets.jpg")


        # ========================================
        # Programs
        # ========================================

        # Row 1

        elif value == "program1":
            self.showPage("programs/3DModelling.html")

        elif value == "program2":
            self.showPage("programs/Automation.html")

        elif value == "program3":
            self.showPage("programs/BoysinSTEM.html")

        elif value == "program4":
            self.showPage("programs/Bushfood.html")


        # Row 2

        elif value == "program5":
            self.showPage("programs/CyberCity.html")

        elif value == "program6":
            self.showPage("programs/GameDesignOnline.html")

        elif value == "program7":
            self.showPage("programs/GameMaker.html")

        elif value == "program8":
            self.showPage("programs/GameofDrones.html")


        # Row 3

        elif value == "program9":
            self.showPage("programs/GirlsinSTEM.html")

        elif value == "program10":
            self.showPage("programs/KoorieMotion.html")

        elif value == "program11":
            self.showPage("programs/MolecularGenetics.html")

        elif value == "program12":
            self.showPage("programs/PCBuilder.html")


        # Row 4

        elif value == "program13":
            self.showPage("programs/PerceptualDistortion.html")

        elif value == "program14":
            self.showPage("programs/PeterDoherty.html")

        elif value == "program15":
            self.showPage("programs/Photosynthesis.html")

        elif value == "program16":
            self.showPage("programs/Prototyping.html")


        # Row 5

        elif value == "program17":
            self.showPage("programs/VCE%20Psychology.html")

        elif value == "program18":
            self.showPage("programs/Questions%20in%20Science.html")

        elif value == "program19":
            self.showPage("programs/Renewables.html")

        elif value == "program20":
            self.showPage("programs/RobotMissions.html")


        # Row 6

        elif value == "program21":
            self.showPage("programs/SoilScience.html")

        elif value == "program22":
            self.showPage("programs/STEMAcademies.html")

        elif value == "program23":
            self.showPage("programs/STEMinAction.html")

        elif value == "program24":
            self.showPage("programs/STEMIsland.html")

        # ========================================
        # facial recognition
        # ========================================
        elif value == "exsistedUser":
            self.showPage("exsistedUser.html")

        elif value == "newUser":
            self.showPage("newUser.html")



    def onTabletEvent(self, key, value, message):

        print "Back Event:", key
        print "Back to tag:", value

        tag_name = str(value)

        # ========================================
        # Main menu
        # ========================================

        if tag_name == "informationMenu":



            self.dialog.gotoTag(
                "informationMenu",
                "greetingtopic"
            )


        elif tag_name == "start":

            self.dialog.gotoTag(
                "informationMenu",
                "greetingtopic"
            )


        elif tag_name == "roomList":

            self.dialog.gotoTag(
                "roomList",
                "greetingtopic"
            )


        elif tag_name == "programList":

            self.showPage(
                "programs/programs.html"
            )

            self.dialog.gotoTag(
                "programList",
                "greetingtopic"
            )

        elif tag_name == "historyMenu":

            self.showPage(
                "history.html"
            )

            self.dialog.gotoTag(
                "historyVoice",
                "greetingtopic"
            )

        elif tag_name == "weather":

            self.showPage(
                "weather.html"
            )

            self.dialog.gotoTag(
                "weather",
                "greetingtopic"
            )

        elif tag_name == "contact":

            self.showPage(
                "contact.html"
            )

            self.dialog.gotoTag(
                "contact",
                "greetingtopic"
            )


        elif tag_name == "facialrecog":

            self.showPage(
                "facialMenu.html"
            )

            self.dialog.gotoTag(
                "facialrecog",
                "greetingtopic"
            )


        elif tag_name == "repeat":

            self.dialog.gotoTag(
                "informationMenu",
                "greetingtopic"
            )




        # ========================================
        # Programs
        # ========================================

        elif tag_name.startswith("program"):

            program_pages = {
                "program1":  "programs/3D%20Modelling.html",
                "program2":  "programs/Automation.html",
                "program3":  "programs/BoysinSTEM.html",
                "program4":  "programs/Bushfood.html",
                "program5":  "programs/CyberCity.html",
                "program6":  "programs/GameDesignOnline.html",
                "program7":  "programs/GameMaker.html",
                "program8":  "programs/GameofDrones.html",
                "program9":  "programs/GirlsinSTEM.html",
                "program10": "programs/KoorieMotion.html",
                "program11": "programs/MolecularGenetics.html",
                "program12": "programs/PCBuilder.html",
                "program13": "programs/PerceptualDistortion.html",
                "program14": "programs/PeterDoherty.html",
                "program15": "programs/Photosynthesis.html",
                "program16": "programs/Prototyping.html",
                "program17": "programs/VCE%20Psychology.html",
                "program18": "programs/Questions%20in%20Science.html",
                "program19": "programs/Renewables.html",
                "program20": "programs/RobotMissions.html",
                "program21": "programs/SoilScience.html",
                "program22": "programs/STEMAcademies.html",
                "program23": "programs/STEMinAction.html",
                "program24": "programs/STEMIsland.html",
                "program25": "programs/STEMShowdown.html",
                "program26": "programs/Transformation.html",
                "program27": "programs/VCE%20Psycology.html"
            }

            if tag_name in program_pages:

                # Change tablet page
                self.showPage(
                    program_pages[tag_name]
                )

                # Change dialog position
                try:

                    self.dialog.gotoTag(
                        tag_name,
                        "greetingtopic"
                    )

                except Exception as error:

                    self.logger.warning(
                        "Dialog tag not found: "
                        + tag_name
                        + " | "
                        + str(error)
                    )

            else:

                self.logger.warning(
                    "Unknown program: "
                    + tag_name
                )


        # ========================================
        # Rooms
        # ========================================

        elif tag_name == "roomlist":

            self.showPage(
                "roomlists.html"
            )

            self.dialog.gotoTag(
                "roomList",
                "greetingtopic"
            )


        elif tag_name == "room1":

            self.dialog.gotoTag(
                "room1",
                "greetingtopic"
            )


        elif tag_name == "room2":

            self.dialog.gotoTag(
                "room2",
                "greetingtopic"
            )


        elif tag_name == "room3":

            self.dialog.gotoTag(
                "room3",
                "greetingtopic"
            )




        # ========================================
        # Facial Recognition
        # ========================================

        elif tag_name == "recognition_yes":

            self.logger.info(
                "Tablet requested face recognition."
            )

            # ========================================
            # CHECK DIALOG STATE AT THIS MOMENT
            # ========================================

            try:

                topics = self.dialog.getActivatedTopics()

                self.logger.info(
                    "Activated topics BEFORE event: "
                    + str(topics)
                )

                focus = self.dialog.getFocus()

                self.logger.info(
                    "Dialog focus BEFORE event: "
                    + str(focus)
                )

            except Exception as error:

                self.logger.error(
                    "Dialog state check error: "
                    + str(error)
                )





            # ========================================
            # START FACE RECOGNITION
            # ========================================

            self.startRecognition()


        elif tag_name == "registration_yes":

            self.logger.info(
                "Tablet requested face registration."
            )

            self.startRegistration()


        elif tag_name.startswith("register_name|"):

            try:

                parts = tag_name.split("|", 1)

                if len(parts) < 2:
                    return


                name = parts[1].strip()


                if name == "":

                    self.memory.raiseEvent(
                        "faceStatus",
                        "name_error"
                    )

                    return


                self.registrationName = name

                self.faceMode = "registration"

                self.registrationRunning = True


                self.faceDetection.setTrackingEnabled(
                    True
                )


                self.memory.raiseEvent(
                    "faceStatus",
                    "looking"
                )


                self.logger.info(
                    "Registration name received: "
                    + self.registrationName
                )


            except Exception as error:

                self.logger.error(
                    "register_name error: "
                    + str(error)
                )

                self.memory.raiseEvent(
                    "faceStatus",
                    "error"
                )


        elif tag_name == "save_face":

            self.saveRegisteredFace()

        elif tag_name == "registration_again":

            self.logger.info(
                "Retrying face registration."
            )

            self.retryRegistration()


        elif tag_name == "facialMenu":

            self.logger.info(
                "Returning to facial recognition menu."
            )

            self.stopFaceProcess()

            self.showPage(
                "facialMenu.html"
            )

            self.memory.raiseEvent(
                "faceReturnMenu",
                True
            )

        elif tag_name == "recognition_again":

            self.logger.info(
                "Retrying face recognition."
            )

            self.startRecognition()





        # ========================================
        # Unknown
        # ========================================

        else:

            print "Unknown tag:", tag_name


    def onInput_askRecognition(self):

        self.logger.info(
            "Starting ask recognition dialog"
            )

        try:
            self.dialog.gotoTag(
                "askRecognition",
                "askrecognition"
            )

        except Exception as error:
            self.logger.error(
                "askRecognition error: "
                + str(error)
            )


#    def onReceptionAnswer(self, key, value, message):

#        answer = str(value).strip().lower()

#        self.logger.info(
#            "ReceptionAnswer received: " + answer
#        )

#    # ========================================
#    # 1. Ask face recognition
#    # ========================================

#        if answer == "recognition_yes":

#            self.logger.info(
#                "User wants face recognition."
#            )

#            self.recognitionYes()


#        elif answer == "recognition_no":

#            self.logger.info(
#                "User does not want face recognition."
#            )

#            self.recognitionNo()


#    # ========================================
#    # 2. Ask face registration
#    # ========================================

#        elif answer == "registration_yes":

#            self.logger.info(
#                "User wants to register face."
#            )

#            self.registrationYes()


#        elif answer == "registration_no":

#            self.logger.info(
#                "User does not want to register face."
#            )

#            self.registrationNo()


#    # ========================================
#    # 3. Ask recognition again
#    # ========================================

#        elif answer == "again_yes":

#            self.logger.info(
#                "User wants recognition again."
#            )

#            self.recognizeAgainYes()


#        elif answer == "again_no":

