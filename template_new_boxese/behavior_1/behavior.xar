#            )




    def onWeatherEvent(self, key, value, message):

        self.logger.info(
            "========== WEATHER EVENT START =========="
        )

        # STEP 1
        self.logger.info(
            "STEP 1: onWeatherEvent triggered"
        )

        self.logger.info(
            "Event key: " + str(key)
        )

        self.logger.info(
            "Received value: " + str(value)
        )


        try:

            # STEP 2
            self.logger.info(
                "STEP 2: Converting value to string"
            )

            weatherData = str(value)

            self.logger.info(
                "weatherData = " + weatherData
            )


            # STEP 3
            self.logger.info(
                "STEP 3: Splitting weather data"
            )

            parts = weatherData.split("|")

            self.logger.info(
                "Number of parts = " + str(len(parts))
            )


            # Check data
            if len(parts) < 2:

                self.logger.error(
                    "ERROR: Invalid weather data"
                )

                self.logger.error(
                    "Expected format: Weather|Temperature"
                )

                return


            # STEP 4
            self.logger.info(
                "STEP 4: Reading weather value"
            )

            weather = parts[0]

            self.logger.info(
                "Weather = " + weather
            )


            # STEP 5
            self.logger.info(
                "STEP 5: Reading temperature value"
            )

            temperature = parts[1]

            self.logger.info(
                "Temperature = " + temperature
            )


            # STEP 6
            self.logger.info(
                "STEP 6: Creating TTS text"
            )

            text = (
                "Today's weather is "
                + weather
                + ". The temperature is "
                + temperature
                + " degrees Celsius."

            )

            self.logger.info(
                "TTS text = " + text
            )


            # STEP 7
            self.logger.info(
                "STEP 7: Calling ALTextToSpeech.say()"
            )

            self.tts.say(text)


            # STEP 8
            self.logger.info(
                "STEP 8: TTS completed successfully"
            )

            self.memory.raiseEvent(
                "weatherFinished",
                True
            )


        except Exception as error:

            self.logger.error(
                "WEATHER EVENT ERROR: "
                + str(error)
            )


        self.logger.info(
            "========== WEATHER EVENT END =========="
        )

    # ========================================
    # Start new user face registration
    # ========================================

    # ========================================
    # Start existing user face recognition
    # ========================================

    def startRecognition(self):

        self.logger.info(
            "========== START FACE RECOGNITION =========="
        )

        try:

            self.faceMode = "recognition"

            self.recognitionRunning = True
            self.registrationRunning = False

            self.lastRecognizedName = ""


            # Enable Pepper recognition
            self.faceDetection.setRecognitionEnabled(
                True
            )


            # Enable face tracking
            self.faceDetection.setTrackingEnabled(
                True
            )


            self.logger.info(
                "ALFaceDetection recognition enabled."
            )


            # Update webpage status
            self.memory.raiseEvent(
                "faceStatus",
                "looking"
            )


            self.logger.info(
                "Waiting for FaceDetected event..."
            )


        except Exception as error:

            self.recognitionRunning = False

            self.logger.error(
                "startRecognition error: "
                + str(error)
            )

            self.memory.raiseEvent(
                "faceStatus",
                "error"
            )
    # ========================================
    # Start new user face registration
    # ========================================

    def startRegistration(self):

        self.logger.info(
            "========== START FACE REGISTRATION =========="
        )

        try:

            self.faceMode = "registration"

            self.registrationRunning = True
            self.recognitionRunning = False

            self.registrationName = ""


            # We only track the face for now.
            # DO NOT call learnFace() yet.
            self.faceDetection.setTrackingEnabled(
                True
            )


            self.logger.info(
                "Face registration mode started."
            )


            # Tell webpage that next step is entering name
            self.memory.raiseEvent(
                "faceStatus",
                "enter_name"
            )


        except Exception as error:

            self.registrationRunning = False

            self.logger.error(
                "startRegistration error: "
                + str(error)
            )

            self.memory.raiseEvent(
                "faceStatus",
                "error"
            )

    # ========================================
    # Process existing user recognition
    # ========================================

    def processRecognitionResult(self, faces):

        try:

            recognizedName = ""
            recognitionScore = 0.0

            for face in faces:

                try:

                    # FaceDetected normally contains:
                    # face[0] = shape information
                    # face[1] = extra information
                    #
                    # extraInfo[1] = recognition score
                    # extraInfo[2] = recognized name

                    if len(face) < 2:
                        continue

                    extraInfo = face[1]

                    if extraInfo is None:
                        continue

                    if len(extraInfo) < 3:
                        continue

                    score = extraInfo[1]
                    name = extraInfo[2]

                    if name is None:
                        continue

                    name = str(name).strip()

                    try:
                        scoreValue = float(score)

                    except Exception:
                        scoreValue = 0.0

                    self.logger.info(
                        "Recognition candidate: "
                        + name
                        + " score="
                        + str(scoreValue)
                    )

                    if (
                        name != ""
                        and scoreValue > recognitionScore
                    ):
                        recognizedName = name
                        recognitionScore = scoreValue

                except Exception as error:

                    self.logger.warning(
                        "Unable to parse one face: "
                        + str(error)
                    )

            # ========================================
            # Recognized
            # ========================================

            if recognizedName != "":

                # Stop FIRST to avoid repeated recognition
                self.recognitionRunning = False
                self.faceMode = None

                self.lastRecognizedName = recognizedName

                self.logger.info(
                    "Recognized user: "
                    + recognizedName
                )

                try:
                    self.faceDetection.setTrackingEnabled(
                        False
                    )

                    self.faceDetection.setRecognitionEnabled(
                        False
                    )

                except Exception as error:

                    self.logger.warning(
                        "Could not stop recognition: "
                        + str(error)
                    )


                # Update webpage
                self.memory.raiseEvent(
                    "faceStatus",
                    "recognized|"
                    + recognizedName
                )




                self.logger.info(
                    "Sending recognized name to Dialog: "
                    + recognizedName
                )

                try:

                    # Put the recognized name into the QiChat dynamic concept
                    self.dialog.setConcept(
                        "recognized_face_name",
                        "enu",
                        [recognizedName]
                    )

                    # Simulate the Dialog input
                    self.dialog.forceInput(
                        "face recognized " + recognizedName
                    )

                    self.logger.info(
                        "Dialog recognition output triggered for: "
                        + recognizedName
                    )

                except Exception as error:

                    self.logger.error(
                        "Could not send recognized name to Dialog: "
                        + str(error)
                    )
            else:

                self.recognitionRunning = False
                self.faceMode = None

                self.logger.info(
                    "Face detected but user unknown."
                )

                self.memory.raiseEvent(
                    "faceStatus",
                    "unknown"
                )
                try:

                    self.dialog.gotoTag(
                        "faceRecognitionUnknownOutput",
                        "greetingtopic"
                    )

                except Exception as error:

                    self.logger.error(
                        "Could not trigger recognition failure dialog: "
                        + str(error)
                    )


        except Exception as error:

            self.logger.error(
                "processRecognitionResult error: "
                + str(error)
            )

            self.recognitionRunning = False
            self.faceMode = None

            self.memory.raiseEvent(
                "faceStatus",
                "error"
            )

        # ========================================
        # Process registration face
        # ========================================

    def processRegistrationFace(self, faces):

        try:

            if len(faces) == 0:

                self.memory.raiseEvent(
                    "faceStatus",
                    "looking"
                )

                return


            if self.registrationName == "":

                self.memory.raiseEvent(
                    "faceStatus",
                    "enter_name"
                )

                return


            self.logger.info(
                "Registration face detected for: "
                + self.registrationName
            )


            # Stop repeated FaceDetected processing
            self.registrationRunning = False


            # Tell webpage
            self.memory.raiseEvent(
                "faceStatus",
                "face_ready|"
                + self.registrationName
            )

            self.memory.raiseEvent(
                "faceRegistrationReady",
                self.registrationName
            )




        except Exception as error:

            self.logger.error(
                "processRegistrationFace error: "
                + str(error)
            )

    # ========================================
    # Save registered face
    # ========================================

    def saveRegisteredFace(self):

        self.logger.info(
            "========== SAVE REGISTERED FACE =========="
        )

        try:

            if self.registrationName == "":

                self.logger.warning(
                    "Cannot save face: registrationName is empty."
                )

                self.memory.raiseEvent(
                    "faceStatus",
                    "name_error"
                )

                return

            self.logger.info(
                "Saving face for: "
                + self.registrationName
            )


            learnedFaces = (
                self.faceDetection.getLearnedFacesList()
            )

            self.logger.info(
                "Current learned faces: "
                + str(learnedFaces)
            )

            self.logger.info(
                "Trying learnFace for: "
                + self.registrationName
            )


            learnedFaces = (
                self.faceDetection.getLearnedFacesList()
            )

            self.logger.info(
                "Current learned faces: "
                + str(learnedFaces)
            )

            self.logger.info(
                "Saving face for: "
                + self.registrationName
            )


            if self.registrationName in learnedFaces:

                self.logger.info(
                    "Name already exists. Re-learning face for: "
                    + self.registrationName
                )

                result = self.faceDetection.reLearnFace(
                    self.registrationName
                )

            else:

                self.logger.info(
                    "New name. Learning face for: "
                    + self.registrationName
                )

                result = self.faceDetection.learnFace(
                    self.registrationName
                )


            self.logger.info(
                "Face learning result: "
                + str(result)
            )


            self.logger.info(
                "learnFace result: "
                + str(result)
            )

            if result:

                # ========================================
                # Registration successful
                # ========================================

                self.registrationRunning = False
                self.faceMode = None

                self.logger.info(
                    "Face registration successful: "
                    + self.registrationName
                )

                # Update tablet status
                self.memory.raiseEvent(
                    "faceStatus",
                    "registration_success|"
                    + self.registrationName
                )

                # Stop face tracking
                try:

                    self.faceDetection.setTrackingEnabled(
                        False
                    )

                except Exception as error:

                    self.logger.warning(
                        "Could not stop face tracking: "
                        + str(error)
                    )

                # ========================================
                # Let Dialog announce the registered name
                # ========================================

                try:

                    self.dialog.setConcept(
                        "registered_face_name",
                        "enu",
                        [self.registrationName]
                    )

                    self.logger.info(
                        "Registered name sent to Dialog: "
                        + self.registrationName
                    )

                    self.dialog.forceInput(
                        "face registration successful "
                        + self.registrationName
                    )

                    self.logger.info(
                        "Registration success announcement triggered."
                    )

                except Exception as error:

                    self.logger.error(
                        "Could not announce registration success: "
                        + str(error)
                    )

                # Wait for Pepper to finish the short sentence
                time.sleep(2.0)

                # ========================================
                # Return tablet to facial recognition menu
                # ========================================

                self.showPage(
                    "facialMenu.html"
                )

                self.logger.info(
                    "Tablet returned to facial recognition menu."
                )

                # ========================================
                # Return Dialog to facial recognition menu
                # ========================================

                try:

                    self.dialog.gotoTag(
                        "facialrecog",
                        "greetingtopic"
                    )

                    self.logger.info(
                        "Dialog returned to facial recognition menu."
                    )

                except Exception as error:

                    self.logger.error(
                        "Could not return Dialog to facial recognition menu: "
                        + str(error)
                    )

            # ========================================
            # Registration failed
            # ========================================

            else:

                self.logger.warning(
                    "learnFace returned False for: "
                    + self.registrationName
                )

                self.memory.raiseEvent(
                    "faceStatus",
                    "registration_failed"
                )

                self.memory.raiseEvent(
                    "faceRegistrationFailed",
                    True
                )
                # Allow retry
                self.registrationRunning = False
                self.faceMode = None

        # THIS except was missing
        except Exception as error:

            self.logger.error(
                "saveRegisteredFace error: "
                + str(error)
            )

            self.registrationRunning = False
            self.faceMode = None

            self.memory.raiseEvent(
                "faceStatus",
                "error"
            )



# ========================================
# Retry registration calibration
# ========================================

    def retryRegistration(self):

        try:

            if self.registrationName == "":

                self.memory.raiseEvent(
                    "faceStatus",
                    "enter_name"
                )

                return

            self.logger.info(
                "Retrying registration for: "
                + self.registrationName
            )

            self.faceMode = "registration"
            self.registrationRunning = True

            self.faceDetection.setTrackingEnabled(
                True
            )

            self.memory.raiseEvent(
                "faceStatus",
                "looking"
            )

        except Exception as error:

            self.logger.error(
                "retryRegistration error: "
                + str(error)
            )

            self.memory.raiseEvent(
                "faceStatus",
                "error"
            )

    def onFaceDetected(self, key, value, message):

        try:

            if (
                not self.recognitionRunning
                and not self.registrationRunning
            ):
                return

            if value is None:
                return

            if len(value) < 2:

                self.memory.raiseEvent(
                    "faceStatus",
                    "looking"
                )

                return

            faces = value[1]

            if faces is None or len(faces) == 0:

                self.memory.raiseEvent(
                    "faceStatus",
                    "looking"
                )

                return

            self.logger.info(
                "FaceDetected event received."
            )

            self.memory.raiseEvent(
                "faceStatus",
                "face_detected"
            )

            if self.faceMode == "recognition":

                self.processRecognitionResult(
                    faces
                )

            elif self.faceMode == "registration":

                self.processRegistrationFace(
                    faces
                )

        except Exception as error:

            self.logger.error(
                "onFaceDetected error: "
                + str(error)
            )

            self.memory.raiseEvent(
                "faceStatus",
                "error"
            )

    def stopFaceProcess(self):

        self.logger.info(
            "Stopping face process."
        )

        self.recognitionRunning = False
        self.registrationRunning = False
        self.faceMode = None

        try:

            self.faceDetection.setTrackingEnabled(
                False
            )

        except Exception as error:

            self.logger.warning(
                "Could not disable face tracking: "
                + str(error)
            )

    def showPage(self, page):
        try:
            if page.startswith("http://") or page.startswith("https://"):
                url = page
            else:
                url = (
                    "http://198.18.0.1/apps/"
                    ".lastUploadedChoregrapheBehavior/"
                    + page
                    + "?v="
                    + str(int(time.time()))
                )

            print "Loading page:", url

            load_result = self.tablet.loadUrl(url)
            print "loadUrl result:", load_result

            show_result = self.tablet.showWebview()
            print "showWebview result:", show_result

        except Exception as error:
            print "showPage error:", error]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Input name="askRecognition" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="5" /><Output name="recognitionYes" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" /><Output name="recognitionNo" type="1" type_size="1" nature="2" inner="0" tooltip="" id="7" /><Output name="registrationYes" type="1" type_size="1" nature="2" inner="0" tooltip="" id="8" /><Output name="registrationNo" type="1" type_size="1" nature="2" inner="0" tooltip="" id="9" /><Output name="recognizeAgainYes" type="1" type_size="1" nature="2" inner="0" tooltip="" id="10" /><Output name="recognizeAgainNo" type="1" type_size="1" nature="2" inner="0" tooltip="" id="11" /></Box><Box name="Recoginize Face" id="22" localization="8" tooltip="" x="401" y="257"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)

        self.memory = None
        self.face = None
        self.running = False

    def onLoad(self):

        self.memory = ALProxy("ALMemory")
        self.face = ALProxy("ALFaceDetection")

    def onUnload(self):

        self.stopRecognition()

    def stopRecognition(self):

        if not self.running:
            return

        try:
            self.memory.unsubscribeToEvent(
                "FaceDetected",
                self.getName()
            )
        except:
            pass

        try:
            self.face.unsubscribe(self.getName())
        except:
            pass

        self.running = False

    def onInput_onStart(self):

        if self.running:
            return

        self.running = True

        self.face.setRecognitionEnabled(True)

        self.face.subscribe(
            self.getName(),
            500,
            0.0
        )

        self.memory.subscribeToEvent(
            "FaceDetected",
            self.getName(),
            "onFaceDetected"
        )

    def onFaceDetected(self, key, value, message):

        if not self.running:
            return

        # 第一阶段先把 Pepper 的实际返回值打印出来
        self.logger.info(
            "FaceDetected VALUE = " + str(value)
        )

        if not value:
            return

        if len(value) < 2:
            return

        faces = value[1]

        if not faces:
            return

        try:

            faceInfo = faces[0]

            # Recognition information
            extraInfo = faceInfo[1]

            self.logger.info(
                "ExtraInfo = " + str(extraInfo)
            )

            name = ""

            # 这里暂时不要盲目假设你的 2.5.10.7
            # 返回结构与所有旧版示例完全相同。
            #
            # 实机运行以后，我们根据 Log 中的
            # ExtraInfo 精确确定 name 的位置。

            if len(extraInfo) >= 3:
                name = str(extraInfo[2])

            self.stopRecognition()

            if name and name != "":
                self.logger.info(
                    "Recognized: " + name
                )

                self.recognizedName(name)

            else:
                self.logger.info(
                    "Unknown face."
                )

                self.unknown()

        except Exception as e:

            self.logger.error(
                "Recognition parsing error: " + str(e)
            )

    def onInput_onStop(self):

        self.stopRecognition()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /><Output name="recoginizedName" type="3" type_size="1" nature="2" inner="0" tooltip="" id="5" /><Output name="unknown" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" /></Box><Box name="Recognized" id="2" localization="8" tooltip="" x="627" y="567"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)
        self.tts = None

    def onLoad(self):
        self.tts = ALProxy("ALTextToSpeech")

    def onInput_name(self, name):

        text = "Hello " + str(name) + \
               ", welcome back to Ballarat School."

        self.tts.say(text)

        self.done()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="name" type="3" type_size="1" nature="1" inner="0" tooltip="" id="2" /><Output name="done" type="1" type_size="1" nature="2" inner="0" tooltip="" id="3" /></Box><Box name="Receive Visitor Name" id="3" localization="8" tooltip="" x="161" y="488"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)

        self.memory = None
        self.running = False

    def onLoad(self):

        self.memory = ALProxy("ALMemory")

    def onInput_onStart(self):

        if self.running:
            return

        self.running = True

        self.memory.subscribeToEvent(
            "VisitorRegistration/Name",
            self.getName(),
            "onNameReceived"
        )

    def onNameReceived(
        self,
        key,
        value,
        message
    ):

        if not self.running:
            return

        visitorName = str(value).strip()

        if visitorName == "":
            return

        self.logger.info(
            "Visitor name: " + visitorName
        )

        try:
            self.memory.unsubscribeToEvent(
                "VisitorRegistration/Name",
                self.getName()
            )
        except:
            pass

        self.running = False

        self.name(visitorName)

    def onInput_onStop(self):

        if self.running:

            try:
                self.memory.unsubscribeToEvent(
                    "VisitorRegistration/Name",
                    self.getName()
                )
            except:
                pass

            self.running = False]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="name" type="3" type_size="1" nature="2" inner="0" tooltip="" id="4" /></Box><Box name="learn face" id="5" localization="8" tooltip="" x="568" y="376"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)

        self.face = None
        self.tts = None

    def onLoad(self):

        self.face = ALProxy(
            "ALFaceDetection"
        )

        self.tts = ALProxy(
            "ALTextToSpeech"
        )

    def onInput_name(self, name):

        visitorName = str(name).strip()

        if visitorName == "":
            self.failed()
            return

        try:

            # 看看名字是不是已经存在
            learnedFaces = \
                self.face.getLearnedFacesList()

            self.logger.info(
                "Current database: " +
                str(learnedFaces)
            )

            if visitorName in learnedFaces:

                self.logger.info(
                    visitorName +
                    " already exists."
                )

                self.tts.say(
                    visitorName +
                    " is already registered."
                )

                self.failed()
                return

            self.tts.say(
                "Please look at me."
            )

            result = self.face.learnFace(
                visitorName
            )

            self.logger.info(
                "learnFace result: " +
                str(result)
            )

            if result:

                self.tts.say(
                    "Thank you " +
                    visitorName +
                    ". I will remember you."
                )

                self.success(
                    visitorName
                )

            else:

                self.tts.say(
                    "Sorry. I could not "
                    "register your face."
                )

                self.failed()

        except Exception as e:

            self.logger.error(
                "learnFace error: " +
                str(e)
            )

            self.tts.say(
                "Sorry. Something went wrong."
            )

            self.failed()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="name" type="3" type_size="1" nature="1" inner="0" tooltip="" id="2" /><Output name="success" type="3" type_size="1" nature="2" inner="0" tooltip="" id="3" /><Output name="failed" type="1" type_size="1" nature="2" inner="0" tooltip="" id="4" /></Box><Box name="check database" id="6" localization="8" tooltip="" x="387" y="493"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)

        self.face = None

    def onLoad(self):

        self.face = ALProxy(
            "ALFaceDetection"
        )

    def onInput_onStart(self):

        try:

            names = \
                self.face.getLearnedFacesList()

            self.logger.info(
                "===== FACE DATABASE ====="
            )

            for name in names:
                self.logger.info(
                    str(name)
                )

            self.logger.info(
                "========================="
            )

        except Exception as e:

            self.logger.error(
                str(e)
            )

        self.done()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Output name="done" type="1" type_size="1" nature="2" inner="0" tooltip="" id="2" /></Box><Box name="TestName" id="7" localization="8" tooltip="" x="60" y="389"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def onInput_onStart(self):
        self.name("Wong")]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="name" type="3" type_size="1" nature="2" inner="0" tooltip="" id="4" /></Box><Box name="WaitForFace" id="13" localization="8" tooltip="" x="91" y="257"><bitmap>media/images/box/box-python-script.png</bitmap><script language="4"><content><![CDATA[class MyClass(GeneratedClass):

    def __init__(self):
        GeneratedClass.__init__(self)
        self.memory = None
        self.face = None
        self.running = False

    def onLoad(self):
        self.memory = ALProxy("ALMemory")
        self.face = ALProxy("ALFaceDetection")

    def onUnload(self):
        self.stopDetection()

    def stopDetection(self):
        if not self.running:
            return

        try:
            self.memory.unsubscribeToEvent(
                "FaceDetected",
                self.getName()
            )
        except:
            pass

        try:
            self.face.unsubscribe(self.getName())
        except:
            pass

        self.running = False

    def onInput_onStart(self):

        if self.running:
            return

        self.running = True

        # 这里只需要检测，不需要识别
        self.face.setRecognitionEnabled(False)

        self.face.subscribe(
            self.getName(),
            500,
            0.0
        )

        self.memory.subscribeToEvent(
            "FaceDetected",
            self.getName(),
            "onFaceDetected"
        )

    def onFaceDetected(self, key, value, message):

        if not self.running:
            return

        if value and len(value) > 1:

            self.logger.info("Face detected.")

            self.stopDetection()

            self.faceDetected()

    def onInput_onStop(self):
        self.stopDetection()]]></content></script><Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" /><Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" /><Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" /><Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" /><Output name="faceDetected" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" /></Box><Link inputowner="1" indexofinput="2" outputowner="0" indexofoutput="2" /><Link inputowner="14" indexofinput="2" outputowner="1" indexofoutput="4" /><Link inputowner="17" indexofinput="2" outputowner="0" indexofoutput="2" /><Link inputowner="0" indexofinput="4" outputowner="17" indexofoutput="5" /><Link inputowner="16" indexofinput="2" outputowner="14" indexofoutput="3" /><Link inputowner="0" indexofinput="4" outputowner="16" indexofoutput="4" /></Diagram></BehaviorKeyframe></BehaviorLayer></Timeline></Box></ChoregrapheProject>